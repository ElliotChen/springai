###
### DEV
###


TOKENIZERS_PARALLELISM="false"

STRUCTURED_OUTPUT_FRAMEWORK="instructor"
###
### LLM
###


###
### free local LLM, install it
###
LLM_PROVIDER="custom"
LLM_MODEL="openai/llama"
LLM_ENDPOINT="http://host.docker.internal:4000"
LLM_API_KEY="sk-1234"

## Llama.cpp - Gemma Success Settings
EMBEDDING_PROVIDER="custom"
EMBEDDING_MODEL="openai/embed"
EMBEDDING_ENDPOINT="http://host.docker.internal:4000"
EMBEDDING_API_KEY="sk-1234"
EMBEDDING_DIMENSIONS=768
EMBEDDING_MAX_COMPLETION_TOKENS=1600
HUGGINGFACE_TOKENIZER="google/embeddinggemma-300m"


